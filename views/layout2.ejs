		<!-- Painel do menu mobile (hambúrguer). Escrito à mão com os mesmos data-ng-click/
		     ng-repeat do #nav lá em cima: o plugin jQuery do template (navList(), em alpha/assets/js/main.js)
		     clona os links só como texto puro e perde essas diretivas do Angular, o que fazia
		     "Logar" não abrir nada e "Documentos" nunca aparecer no mobile.
		     Precisa ficar FORA do #page-wrapper (irmão dele, direto em <body>): o #page-wrapper
		     ganha um transform quando o painel abre, e isso quebra o position:fixed de um filho. -->
		<div id="navPanel">
			<nav>
				<span class="link depth-0">Certificados</span>
				<a class="link depth-1" href="" data-ng-click="showEmitCertificate($event)"><span class="indent-1"></span>Gerar</a>
				<a class="link depth-1" href="/certificados"><span class="indent-1"></span>Validar</a>
				<a class="link depth-0" href="/contato">Fale Conosco</a>
				<span class="link depth-0">Botões</span>
				<a class="link depth-1" data-ng-repeat="btn in edits[0].botoes" ng-href="{{btn.link}}" target="_blank"><span class="indent-1"></span>{{btn.texto}}</a>
				<a class="link depth-1" data-ng-if="edits[0].cadastro_projetos" href="/projetos/inscricao" target="_blank"><span class="indent-1"></span>Cadastrar projeto</a>
				<a class="link depth-1" data-ng-if="edits[0].cadastro_avaliadores" href="/avaliadores/inscricao" target="_blank"><span class="indent-1"></span>Cadastrar avaliador</a>
				<a class="link depth-1" data-ng-if="edits[0].saberes_docentes" href="/saberes-docentes/inscricao" target="_blank"><span class="indent-1"></span>Saberes Docentes</a>
				<a class="link depth-1" data-ng-if="!edits[0].botoes.length && !edits[0].cadastro_projetos && !edits[0].cadastro_avaliadores && !edits[0].saberes_docentes" href="javascript:void(0);"><span class="indent-1"></span>Nenhum botão disponível</a>
				<span class="link depth-0">Documentos</span>
				<a class="link depth-1" data-ng-repeat="doc in documentos" data-ng-show="doc.exibe" ng-href="{{doc.pdf}}" download="{{doc.titulo}}" target="_blank"><span class="indent-1"></span>{{ doc.titulo }}</a>
				<a class="link depth-1" data-ng-if="documentos.length === 0 || !(documentos | filter:{exibe: true}).length" href="javascript:void(0);"><span class="indent-1"></span>Nenhum documento disponível</a>
				<a class="link depth-0" href="#" data-ng-click="showLoginDialog($event)">Logar</a>
			</nav>
