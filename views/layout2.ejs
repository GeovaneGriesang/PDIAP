<!DOCTYPE html>
<html lang="pt-BR" data-ng-app="PDIAP">

<head>
	<base href="/">
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
	<meta name="description" content="Mostra Venâncio-airense de Cultura e Inovação" />
	<meta name="keywords" content="Venâncio Aires, IFSul, Feira, Mostra, Evento, Comunidade, campus Venâncio Aires" />
	<meta name="robots" content="index, follow" />
	<title>MOVACI</title> <!--CSS-->
	<link rel="shortcut icon" href="assets/images/favicon.png" type="image/x-icon" />
	<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700,400italic">
	<link rel='stylesheet' href="https://fonts.googleapis.com/css?family=Roboto+Condensed:400,300,300italic,400italic">
	<link rel="stylesheet" href="/bower_components/angular-material/angular-material.css">
	<link rel="stylesheet" href="/assets/css/style.css">
	<link rel="stylesheet" href="/alpha/assets/css/main.css" />
</head>

<body class="landing homepage" data-ng-controller="homeCtrl" style="height:initial!important; background-color: #FFFCF7;">
	<div id="page-wrapper" class="alert-theme">

		<!-- Header -->
		<header id="header" class="alt" style="background-color: #f4f0ea70;">
			<a href="/" style="margin-left:50px;">
				<img src="alpha/images/favicon.png" alt="Logo MOVACI" style="height:3.25em;" />
			</a>
			<nav id="nav">
				<ul> <!-- <li> <a href="#" class="icon fa-angle-down">nome</a> <ul> <li><a>Item 1</a></li> <li><a>Item 2</a></li> </ul> </li> -->
					<li>
						<a href="javascript:void(0);">Certificados <span class="icon fa-angle-down"></span></a>
						<ul>
							<li><a href="" data-ng-click="showEmitCertificate($event)">Gerar</a></li>
							<li><a href="/certificados">Validar</a></li>
						</ul>
					</li>
					<li><a href="/contato">Fale Conosco</a></li>
					<li>
						<a href="javascript:void(0);">Botões <span class="icon fa-angle-down"></span></a>
						<ul>
							<li ng-repeat="btn in edits[0].botoes"><a ng-href="{{btn.link}}" target="_blank">{{btn.texto}}</a></li>
							<li ng-if="edits[0].cadastro_projetos"><a href="/projetos/inscricao" target="_blank">Cadastrar projeto</a></li>
							<li ng-if="edits[0].cadastro_avaliadores"><a href="/avaliadores/inscricao" target="_blank">Cadastrar avaliador</a></li>
							<li ng-if="edits[0].saberes_docentes"><a href="/saberes-docentes/inscricao" target="_blank">Saberes Docentes</a></li>
							<li ng-if="!edits[0].botoes.length && !edits[0].cadastro_projetos && !edits[0].cadastro_avaliadores && !edits[0].saberes_docentes">
								<a href="javascript:void(0);" style="font-style: italic; color: #999;">Nenhum botão disponível</a>
							</li>
						</ul>
					</li>
					<li> 
						<a href="localhost">Documentos <span class="icon fa-angle-down"></span></a>
						<ul> 
							<li ng-repeat="doc in documentos" ng-show="doc.exibe">
								<a ng-href="{{doc.pdf}}" download="{{doc.titulo}}" target="_blank">
									{{ doc.titulo }}
								</a>
							</li>
							
							<li ng-if="documentos.length === 0 || !(documentos | filter:{exibe: true}).length">
								<a href="javascript:void(0);" style="font-style: italic; color: #999;">Nenhum documento disponível</a>
							</li>
						</ul>
					</li>
					<li><a href="#" class="button" data-ng-click="showLoginDialog($event)"
							style="outline:none;">Logar</a></li>
				</ul>
			</nav>
		</header>

		<!-- Banner -->
		<section id="banner" style="display: flex;">
			<div class="esquerda">
				<div class="cima" style="text-align: left;margin-left: 4em; margin-top: 15%;">
					<img src="alpha/images/logo3.png" alt="Logo MOVACI" style="margin-top: 20px;">
					<p style="color:#000000!important; font-weight:bold;" ng-bind ="edits[0].edicao + ' Mostra Venâncio-airense '"></p>
					<p style="color:#000000!important; font-weight:bold;"> de Cultura e Inovação</p>
			        <h4 id="prorrog" ng-bind-html="edits[0].text"></h4>
					<ul class="destaques-home" data-ng-if="edits[0].destaques.length > 0" style="list-style:none;padding:0;margin:10px 0;">
						<li data-ng-repeat="d in edits[0].destaques" style="font-weight:bold;color:#225024;">{{d.texto}}</li>
					</ul>

				</div>
				<div class="baixo">
					<p data-ng-if="edits[0].textoProjetos" style="font-size:0.6em;margin:0.5em 0 0 0;">{{edits[0].textoProjetos}}</p>
					<a href="/projetos/inscricao" class="button special" style="margin-top:0.5em;margin-right:0.5" target="_blank" data-ng-if="edits[0].cadastro_projetos == true">Cadastrar projeto</a>
					<p data-ng-if="edits[0].textoAvaliadores" style="font-size:0.6em;margin:0.5em 0 0 0;">{{edits[0].textoAvaliadores}}</p>
					<a href="/avaliadores/inscricao" class="button special" style="margin-top:0.5em" target="_blank" data-ng-if="edits[0].cadastro_avaliadores == true">Cadastrar avaliador</a>
					<a href="/saberes-docentes/inscricao" class="button special" style="margin-top:3em" target="_blank" data-ng-if="edits[0].saberes_docentes == true">Saberes Docentes</a>
					<a ng-href="{{btn.link}}" class="button special" style="margin-top:3em" target="_blank" data-ng-repeat="btn in edits[0].botoes">{{btn.texto}}</a>

					<div class="infos" style="display: flex; margin-left: 80px; margin-top: 90px;">
						<img class="icone-info" src="alpha/images/calendario.png" width="35px" height="35px" style="margin-right: 1%">
						<div style="font-size: 0.5em!important; text-align: left; margin-right: 0.7em">
								<h3 style="margin:0!important;line-height:1.1em;font-weight:bold;" ng-bind="edits[0].dias"></h3>
								<h3 style="margin:0!important;line-height:1.1em;" ng-bind="edits[0].mes"></h3>
								<h3 style="margin:0!important;line-height:1.1em;" ng-bind="edits[0].ano"></h3>
						</div>
						<div class="linha"></div>
						<img class="icone-info" src="alpha/images/localizacao.png" width="40px" height="40px" style="margin-right: 0.5%">
						<div style="font-size: 0.5em!important; text-align: left; margin-right: 0.7em">
							<h3 style="margin:0!important;line-height:1.1em;font-weight:bold;">IFSul</h3>
							<h3 style="margin:0!important;line-height:1.1em;">Campus Venâncio Aires</h3>
						</div>
						<div class="linha"></div>
						<img class="icone-info" src="alpha/images/alunos.png" width="40px" height="40px" style="margin-right: 1%">
						<div style="font-size: 0.5em!important; text-align: left;">
							<h3 style="margin:0!important;line-height:1.1em;font-weight:bold;">Estudantes, docentes,</h3>
							<h3 style="margin:0!important;line-height:1.1em;">pesquisadores(as), gestores(as)</h3>
							<h3 style="margin:0!important;line-height:1.1em;">comunidade externa</h3>
						</div>
					</div>
				</div>
			</div>
			<div class="direita">
				<img src="alpha/images/figuras.png" alt="Logo MOVACI" width="700px" style="float: right;"> <a
					href="movaci.com.br"></a>
			</div>
		</section>

		<!-- Main -->
		<section id="main" style="overflow: hidden; margin-top: 4em;">
			<div id="meio">
				<div id="figura-direita">
					<img src="alpha/images/imgdir1.png">
				</div>
				<div id="figura-esquerda">
					<img src="alpha/images/conjuntofiguras3.png">
				</div>
				
				<div id="meio2">
					<div id="title2">
						<h3>SOBRE O EVENTO</h3>
						<p>O que é a Movaci?</p>
					</div>
					<div id="text2" style="margin-right: 5%;">
						<p style="text-align: justify;">Promovida pelo IFSul Venâncio Aires, a MOVACI tem como objetivo
							incentivar a produção científica, tecnológica e cultural, tanto no câmpus Venâncio Aires, quanto
							nas demais redes de ensino locais e regionais, com o estímulo aos estudantes e seus professores
							na realização de projetos de iniciação científica, inovação tecnológica, capacitação de projetos
							e promoção de momentos de troca de experiências ou saberes entre alunos e docentes das diversas
							áreas do conhecimento.</p>
						<p style="text-align: justify;">A MOVACI objetiva mobilizar estudantes, professores e gestores em
							torno da necessidade de se movimentar em busca da criatividade e inovação, incentivando e
							divulgando os projetos culturais, científicos e tecnológicos mais relevantes.
						<div style="display: flex;">
							<p><img src="alpha/images/interrogacao.png" width="30px" height="60px"
									style="margin-right: 1em;"></p>
							<p style="text-align: justify;">A inscrição de projetos é dividida em duas modalidades: o ensino
								fundamental fará sua inscrição na modalidade <b>exposição de trabalhos</b>. O ensino médio,
								técnico e superior fará sua inscrição na modalidade <b>apresentação de trabalhos</b>. </p>
						</div>
					</div>
					<div id="title3">
						<div class="linha verde"></div>
						<h3>Edições</h3>
						<h4>Anteriores</h4>
						<div class="linha vermelha"></div>
						<p>Relembrar é inspirar. Confira os momentos que marcaram a MOVACI!</p>
					</div>
					<!-- Carrossel da galeria: as imagens vêm de public/alpha/images/galeria/, lidas pelo
					     servidor a cada carregamento da página (routes/index.js). Basta adicionar ou
					     remover arquivos de imagem nessa pasta para atualizar o carrossel. -->
					<div class="galeria-carousel" data-ng-if="galeriaImagens.length > 0">
						<div class="galeria-carousel-track">
							<img data-ng-repeat="img in galeriaImagens" ng-src="/alpha/images/galeria/{{img}}"
								data-ng-class="{ativa: $index === galeriaSlideAtual}"
								alt="Foto de edição anterior da MOVACI">
						</div>
						<button type="button" class="galeria-carousel-seta galeria-carousel-seta--esquerda" ng-click="galeriaAnterior()" data-ng-if="galeriaImagens.length > 1" aria-label="Foto anterior">&#10094;</button>
						<button type="button" class="galeria-carousel-seta galeria-carousel-seta--direita" ng-click="galeriaProxima()" data-ng-if="galeriaImagens.length > 1" aria-label="Próxima foto">&#10095;</button>
						<div class="galeria-carousel-pontos" data-ng-if="galeriaImagens.length > 1">
							<span data-ng-repeat="img in galeriaImagens" data-ng-class="{ativo: $index === galeriaSlideAtual}" ng-click="galeriaIrPara($index)"></span>
						</div>
					</div>
					<script>window.__GALERIA_IMAGENS__ = <%- JSON.stringify(galeriaImagens) %>;</script>
					<div style="margin-top: 10%;">
						<section id="local" class="box special features" style="padding:0!important; background-color: #F4F0EA!important; margin-left: 5%; margin-right: 5%;">
							<div class="features-row" style="height:350px;">
								<section>
									<div id="map"></div>
								</section>
								<section class="localizacao"
									style="float:right;height:100%;text-align:left;display:flex;flex-direction:column;justify-content:center;margin-left: 5%; margin-right: 5%;">
									<div class="info-contato">
										<div style="display:flex;">
											<div> <svg style="width:24px;height:24px;margin-right:15px;" viewBox="0 0 24 24">
													<path fill="#4caf50 "
														d="M12,11.5A2.5,2.5 0 0,1 9.5,9A2.5,2.5 0 0,1 12,6.5A2.5,2.5 0 0,1 14.5,9A2.5,2.5 0 0,1 12,11.5M12,2A7,7 0 0,0 5,9C5,14.25 12,22 12,22C12,22 19,14.25 19,9A7,7 0 0,0 12,2Z" />
												</svg> </div>
											<div>
												<h4>Avenida das Indústrias, 1865</h4>
												<h4>Bairro Universitário</h4>
												<h4 style="margin-bottom:0.5em;">Venâncio Aires/RS - CEP 958000-000</h4>
											</div>
										</div>
										<div style="display:flex;"> 
											<svg style="width:24px;height:24px;margin-right:15px;" viewBox="0 0 24 24">
												<path fill="#4caf50"
													d="M12,3C7.46,3 3.34,4.78 0.29,7.67C0.11,7.85 0,8.1 0,8.38C0,8.66 0.11,8.91 0.29,9.09L2.77,11.57C2.95,11.75 3.2,11.86 3.5,11.86C3.75,11.86 4,11.75 4.18,11.58C4.97,10.84 5.87,10.22 6.84,9.73C7.17,9.57 7.4,9.23 7.4,8.83V5.73C8.85,5.25 10.39,5 12,5C13.59,5 15.14,5.25 16.59,5.72V8.82C16.59,9.21 16.82,9.56 17.15,9.72C18.13,10.21 19,10.84 19.82,11.57C20,11.75 20.25,11.85 20.5,11.85C20.8,11.85 21.05,11.74 21.23,11.56L23.71,9.08C23.89,8.9 24,8.65 24,8.37C24,8.09 23.88,7.85 23.7,7.67C20.65,4.78 16.53,3 12,3M9,7V10C9,10 3,15 3,18V22H21V18C21,15 15,10 15,10V7H13V9H11V7H9M12,12A4,4 0 0,1 16,16A4,4 0 0,1 12,20A4,4 0 0,1 8,16A4,4 0 0,1 12,12M12,13.5A2.5,2.5 0 0,0 9.5,16A2.5,2.5 0 0,0 12,18.5A2.5,2.5 0 0,0 14.5,16A2.5,2.5 0 0,0 12,13.5Z" />
											</svg>
											<h4>(51) 3793-4200</h4>
										</div> 
									</div>
									<a href="/contato" target="_blank" class="button btn-outline">Contato</a>
								</section>
							</div>
						</section>
						<!-- Mapa via Leaflet + OpenStreetMap: gratuito, sem conta nem chave de API
						     (ao contrário do Mapbox GL JS usado antes). -->
						<link href='https://unpkg.com/leaflet@1.9.4/dist/leaflet.css' rel='stylesheet' />
						<script src='https://unpkg.com/leaflet@1.9.4/dist/leaflet.js'></script>

						<script>
							var map = L.map('map').setView([-29.637026, -52.169943], 15);
							L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
								attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
							}).addTo(map);
							L.marker([-29.637026, -52.169943]).addTo(map)
								.bindPopup('IFSul - Câmpus Venâncio Aires');
