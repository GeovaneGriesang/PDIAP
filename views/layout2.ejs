							<a href="https://lightsteelblue-wildcat-192961.hostingersite.com/" target="_blank"><img src="/alpha/images/logolabsiga_b.png" alt="Lab Siga" style="width: 120px; height: auto; max-width: none;"/></a>
							<a href="https://www.instagram.com/lab.siga/" target="_blank" class="icon" style="margin-left: 1em;"><img src="alpha/images/instagram.svg" alt="Instagram Lab Siga" style="width:35px;height:35px;" /></a>

							<span style="width:4px;align-self:stretch;background:#E7EAE7;margin:0 1.5em;"></span>

